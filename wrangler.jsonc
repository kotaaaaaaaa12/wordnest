{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wordnest-quiz",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-16",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [{ "binding": "DB" }],
  "observability": { "enabled": true }
}
